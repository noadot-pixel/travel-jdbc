<%@ page pageEncoding="UTF-8" %>
<%@ page import="model.PostDTO" %>
<%@ page import="util.EscapeUtil" %>
<%--
    게시글 카드 하나. index.jsp / posts.jsp / mypage.jsp가 공통으로 쓴다.
    include 지시어로 "코드째로 복사"되므로, include 하기 전에 아래 변수를 만들어둬야 한다.

        String contextPath          = request.getContextPath();
        PostDTO post                = (반복문의 현재 게시글)
        boolean showMyBadge         = (선택) "내 글" 배지를 보여줄지, 생략하면 false
        String actionsHtml          = (선택) 수정/삭제 같은 버튼 HTML. 안 보여줄 거면 선언하지 않거나 null

    변수 이름이 이 페이지의 변수와 겹치면 중복 선언 에러가 나므로, 미리 선언해두고
    반복문 안에서 값만 바꿔 재사용한다 (아래 예시처럼).
--%>
<article class="story-card">

    <a href="<%= contextPath %>/post/view?bno=<%= post.getBno() %>" class="story-image">
        <img src="<%= contextPath %>/<%= post.getImgPath() %>" alt="<%= EscapeUtil.html(post.getTitle()) %>">
    </a>

    <div class="story-content">

        <div class="story-tags">
            <span class="story-category" data-i18n="country.<%= post.getCountry() %>"><%= EscapeUtil.html(post.getCountryLabel()) %></span>
            <% if (post.getRegion() != null && !post.getRegion().isEmpty()) { %>
            <span class="story-region-tag" data-i18n="region.<%= post.getRegion() %>"><%= EscapeUtil.html(post.getRegionLabel()) %></span>
            <% } %>
            <span class="story-style-tag" data-i18n="style.<%= post.getStyle() %>"><%= EscapeUtil.html(post.getStyleLabel()) %></span>
        </div>

        <h3><a href="<%= contextPath %>/post/view?bno=<%= post.getBno() %>"><%= EscapeUtil.html(post.getTitle()) %></a></h3>

        <div class="story-information">
            <span><a href="<%= contextPath %>/member/profile?id=<%= post.getWriter() %>" class="story-writer-link"><%= EscapeUtil.html(post.getWriterNick()) %></a></span>
            <% if (showMyBadge) { %>
            <span class="my-post-badge" data-i18n="common.myPost">내 글</span>
            <% } %>
            <span><%= post.getRegDate() %></span>
            <span><span data-i18n="common.viewCount">조회</span> <%= post.getViewCnt() %></span>
            <span><span data-i18n="common.likeCount">좋아요</span> <%= post.getLikeCnt() %></span>
        </div>

        <% if (actionsHtml != null) { %>
            <%= actionsHtml %>
        <% } %>

    </div>

</article>
