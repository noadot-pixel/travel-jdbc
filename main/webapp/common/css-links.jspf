<%@ page pageEncoding="UTF-8" %>
<%--
    common.css / mystyle.css를 불러온다. 이 사이트는 Cloudflare 터널 뒤에 있고
    Cloudflare가 .css를 기본 4시간 엣지 캐시로 들고 있어서, 파일을 고쳐도 배포 직후에는
    예전 CSS가 그대로 보이는 문제가 있었다. 파일의 실제 마지막 수정 시각을 쿼리스트링으로
    붙여서, CSS를 고칠 때마다 URL 자체가 바뀌어 캐시를 새로 받아오게 만든다.

    사용하는 페이지는 include 전에 String contextPath를 선언해야 한다.
--%>
<%
    long commonCssVer = new java.io.File(application.getRealPath("/css/common.css")).lastModified();
    long myStyleCssVer = new java.io.File(application.getRealPath("/css/mystyle.css")).lastModified();
%>
<link rel="stylesheet"
      href="<%= contextPath %>/css/common.css?v=<%= commonCssVer %>">

<link rel="stylesheet"
      href="<%= contextPath %>/css/mystyle.css?v=<%= myStyleCssVer %>">
